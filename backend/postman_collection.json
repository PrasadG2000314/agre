            },
            "url": { "raw": "http://localhost:5000/api/drivers", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "drivers"] }
          }
        }
      ]
    },
    {
      "name": "6. Report Generator & Analytics",
      "item": [
        {
          "name": "Get Delivery Report Summary",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:5000/api/reports/summary", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "reports", "summary"] }
          }
        },
        {
          "name": "Export Deliveries as CSV",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:5000/api/reports/export-csv", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "reports", "export-csv"] }
          }
        }
      ]
    },
    {
      "name": "7. Global Multi-Entity Search",
      "item": [
        {
          "name": "Search Users, Drivers, Orders, Products",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:5000/api/search?q=tomatoes", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "search"], "query": [{ "key": "q", "value": "tomatoes" }] }
          }
        }
      ]
    }
  ]
}
